# Copy this file to .env and fill in real values. Never commit .env itself.

# Google Gemini API key (https://aistudio.google.com/apikey).
# Required for real agent reasoning, real DeepEval LLM-as-judge scoring,
# and to populate the LLM-span token/cost section of the golden-signals
# report. If unset, the pipeline runs in OFFLINE_STUB mode: the graph
# topology, conditional routing, checkpointing, real MCP tool calls, the
# real agentic-RAG tool, tiered memory, guardrails, and the reflection
# loop all still run for real — only the LLM "reasoning" steps fall back
# to a deterministic heuristic that still calls the same real tools.
GOOGLE_API_KEY=

# Optional: override the default model from config/config.yaml. Uses
# Google's auto-updating "-latest" alias, not a dated model name.
GEMINI_MODEL=gemini-flash-latest

LOG_LEVEL=INFO
